# Build artifacts
daemon/raptd

# R package build artifacts
r-pkg/src/*.o
r-pkg/src/*.so
r-pkg/*.Rcheck/
r-pkg/*.tar.gz

# Debian build artifacts (in pkg/)
*.deb
*.ddeb
# ... except the published ones in the apt repository, which live under the
# per-suite pool rather than flat in docs/ since 0.1.2. A pattern matching
# only docs/*.deb silently drops every package while still committing the
# indices that name them, publishing a repository that 404s on install.
!docs/pool/**/*.deb
*.buildinfo
*.changes
pkg/debian/.debhelper/
pkg/debian/debhelper-build-stamp
pkg/debian/files
pkg/debian/*.debhelper
pkg/debian/*.substvars
pkg/debian/*.debhelper.log
pkg/debian/rapt/

# R package tarball in root
rapt_*.tar.gz
.Rproj.user
rapt.Rproj
